# -----------------------------------------------------------------------------
# Inhouse-Bitrise — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file — it is gitignored.
# -----------------------------------------------------------------------------

# -- Server --------------------------------------------------------------------
PORT=5001
NODE_ENV=development

# -- Database (choose ONE method) ----------------------------------------------
# Method A — individual fields (recommended for Docker / local):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inhouse_bitrise_db
DB_USER=inhouse_bitrise_user
DB_PASSWORD=your_db_password_here

# Method B — single connection string (overrides Method A if set):
# DATABASE_URL=postgresql://inhouse_bitrise_user:your_db_password_here@localhost:5432/inhouse_bitrise_db

# -- Auth ----------------------------------------------------------------------
# Generate with: openssl rand -hex 64
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# -- URLs ----------------------------------------------------------------------
MASTER_URL=http://localhost:5002
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=

# -- Notifications (optional) --------------------------------------------------
TEAMS_WEBHOOK_URL=

# -- AI Assistant (optional) ---------------------------------------------------
GEMINI_API_KEY=

# -- Runner Settings -----------------------------------------------------------
RUNNER_ENABLED=true
RUNNER_CAPACITY=4

# -- Advanced Runner (optional) ------------------------------------------------
INHOUSE_BITRISE_CACHE_DIR=
INHOUSE_BITRISE_KEEP_WORKSPACES=false
INHOUSE_BITRISE_KEEP_ARTIFACTS=false
INHOUSE_BITRISE_REUSE_WORKSPACE=false
